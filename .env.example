# ---- Required ----
# PostgreSQL connection string (use a dedicated DB user with a strong password)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/glamore?schema=public"
# Public base URL of the deployed app. Used for the QR code target and CSRF origin checks.
APP_URL="https://YOUR-DOMAIN.com"
# Secret used to sign admin sessions. Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string"

# ---- Salon defaults (used only by `npm run db:seed`; editable later in Admin > Settings) ----
SALON_NAME="Glam’more Premium Unisex Salon & Spa"
# Replace with the verified Google review link (Google Business Profile > "Ask for reviews")
GOOGLE_REVIEW_URL="https://search.google.com/local/writereview?placeid=YOUR_PLACE_ID"

# ---- AI provider (server-side only; never exposed to the browser) ----
# anthropic | openai | none. For offline dev/tests only: "mock" together with ALLOW_MOCK_AI="true"
AI_PROVIDER="anthropic"
AI_MODEL="claude-haiku-5-5"
ANTHROPIC_API_KEY=""
# For provider=openai (any OpenAI-compatible chat completions API)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
# Cost controls
AI_DAILY_LIMIT="300"
AI_MAX_PER_SESSION="5"

# ---- Proxy / rate limiting ----
# Set to "true" only when running behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY="true"

# ---- Optional: first admin created by `npm run db:seed` ----
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
